# Optional persistent PostgreSQL storage. Replace every placeholder before use.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Set this to the exact origin used by the browser in a hosted deployment.
APP_ORIGIN=http://localhost:3000

# Optional deployed and initialized NEAR testnet approval contract.
NEXT_PUBLIC_NEAR_TESTNET_CONTRACT_ID=your-contract.testnet
